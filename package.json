{
  "name": "heliogrid-mission-console",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-import-boundaries.mjs",
    "check:vocabulary": "node scripts/check-legacy-vocabulary.mjs",
    "check": "vue-tsc -b && npm run lint && npm run format:check && npm run test && npm run check:boundaries && npm run check:vocabulary"
  },
  "dependencies": {
    "@primeuix/themes": "^3.0.0",
    "chart.js": "^4.5.1",
    "pinia": "^4.0.2",
    "primeicons": "^8.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.2.7",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
